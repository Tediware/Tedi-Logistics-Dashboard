# Copy to .env.local and fill in. Never commit .env.local.
#
# Only TEDIWARE_API_KEY is needed. Without it the app still starts, but
# nothing syncs. The server prints what is configured at startup.

# A read-only API key: the app never sends anything. Create one at
# https://tediware.com/app/api-keys.
TEDIWARE_API_KEY=

# Optional. Tediware's address, scheme and host only (default
# https://tediware.com).
# TEDIWARE_BASE_URL=https://tediware.com

# Optional. Seconds between checks for new documents (default 60). 0 turns
# background syncing off; use Sync now or `npm run sync` instead.
# SYNC_INTERVAL_SECONDS=60

# Optional. How many days back the first sync reads (default 45, as long as
# Tediware keeps results).
# SYNC_DAYS=45

# Optional. Where the SQLite file lives (default data/app.db).
# DATABASE_URL=
