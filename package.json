{
  "name": "tediware-carrier-dashboard",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "npm run db:migrate",
    "dev": "next dev -p 3007",
    "build": "NODE_ENV=production next build",
    "start": "next start -p 3007",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test $(find lib scripts -name '*.test.ts')",
    "check": "npm run typecheck && npm run lint && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:reset": "rm -f data/app.db data/app.db-shm data/app.db-wal && npm run db:migrate",
    "sync": "tsx --conditions react-server scripts/sync.ts",
    "sync:rebuild": "tsx --conditions react-server scripts/sync.ts --rebuild",
    "geo:postal": "tsx scripts/build-postal-centroids.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.23.0",
    "maplibre-gl": "^6.12.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tediware/tedi": "^0.10.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  },
  "license": "MIT",
  "description": "A carrier's tenders, loads and compliance, synced read-only from a Tediware account."
}
